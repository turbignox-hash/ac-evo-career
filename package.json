{
  "name": "ac-evo-career",
  "version": "0.1.57",
  "private": true,
  "type": "module",
  "description": "Carriera persistente e locale per Assetto Corsa EVO: nessuna mod ai dati di gioco, nessuna app esterna richiesta.",
  "bin": {
    "ac-evo-career": "./ac-evo-career.mjs"
  },
  "scripts": {
    "start": "node ./ac-evo-career.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "uiapp": "node tools/genera-uiapp.mjs",
    "magazzino": "node tools/magazzino-check.mjs",
    "bump": "node tools/bump-versione.mjs",
    "lint": "biome lint src tools test gui/js uiapp ac-evo-career.mjs --error-on-warnings",
    "check": "npm test && npm run lint",
    "installer": "node tools/build-installer-exe.mjs",
    "installer:offline": "node tools/build-installer-exe.mjs --offline",
    "verifica-firma": "node tools/build-installer-exe.mjs --verifica-firma"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "playwright-core": "^1.58.1"
  }
}
