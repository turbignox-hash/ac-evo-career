{
  "name": "ac-evo-career",
  "version": "0.1.48",
  "private": true,
  "type": "module",
  "description": "Carriera persistente automatizzata per Assetto Corsa EVO, ispirata a un'app di carriera per AMS2.",
  "bin": {
    "ac-evo-career": "./ac-evo-career.mjs"
  },
  "scripts": {
    "start": "node ./ac-evo-career.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "uiapp": "node tools/genera-uiapp.mjs",
    "magazzino": "node tools/magazzino-check.mjs",
    "bump": "node tools/bump-versione.mjs",
    "lint": "biome lint src tools test gui/js uiapp ac-evo-career.mjs",
    "check": "npm test && npm run lint"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "playwright-core": "^1.58.1"
  }
}
