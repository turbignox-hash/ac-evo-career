# Generati: non vanno versionati — MA i cataloghi STATICI dell'auto (25/10,
# installazione pulita: senza questi la GUI nasce muta sull'auto e il Prepara
# non può scriverla) vanno CON il repo. data/* (non data/) permette la
# ri-nezione manuale dei singoli file: il save e gli altri restano fuori.
data/*
!data/car-images.json
!data/car-image-baseline.json
!data/car-prices.json
!data/car-specs.json
!data/car-specs-extra.json
!data/car-guids.json
# DIZIONARIO AUTO DEL GARAGE (27/10, sta a: «e sul pc dell'amico che si
# fa?»): le coppie hash→nome che il tool ha già imparato (oggi 15 auto —
# Alfa 75, Golf MK8, RX-7, SF-25, 296 GT3…) viaggiano col repo e con lo
# zip amico: l'amico NON parte con dizionario vuoto e alla prima gara di
# una serie già nota il Prepara l'auto da solo. Le auto NUOVE restano
# fuori (come sempre: si impara a fine gara, learnCar silenzioso) e
# niente di personale sta dentro: sono solo coppia tecnica + nome auto.
# Git non ri-include file dentro cartelle ignorate: apro SOLO la catena
# samples/garage e la richiudo subito (i campioni .hex e i .log restano fuori).
!data/samples/
data/samples/*
!data/samples/garage/
data/samples/garage/*
!data/samples/garage/map.json
demo/
dist/

# pacchetti amico e sonde di sessione (24/10: build zii local, probe/tasklist diag)
pacchetti/
test/_probe-*.ps1

# le immagini auto/piste (78 MB) restano su disco: solo asset locali, fuori dal repo
gui/carmaps/
gui/trackmaps/

# log runtime e backup locali
*.log
*.bak-lap*
garage-sampler.log
webui-live.log
track-monitor.log
*.bak-laps*

# script e backup di sessione (usa/riesegui ma non versionare)
*.tmp.ps1
*.tmp.mjs
.webui-log.txt
.backup-*/
.setup-backup/
sessione-*/

# backup di griglia e runtime web (24/10: la discarica resta locale, ora c'è pruneBackups)
*.bak-griglia*
*.bak-apply*
.webui.pid
_server-log.txt
_crashlog.ps1
*.customgrid.bak-20*
# backup di salvataggi e scarti di curl nella root
*.bak-20*
http_code
*.bak-*
node_modules/
