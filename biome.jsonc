{
  "$schema": "https://biomejs.dev/schemas/2.3.12/schema.json",
  // ============ IL PONTE (26/10, pulizia debiti Biome) ============
  // formatter SEMPRE spento: lo stile è del progetto, Biome non riscrive
  //   35k righe di codice che funziona (lezione 24/10: 35k diff riformattati).
  // organizeImports spento: gli import sono composti a mano, non in ordine automatico.
  // noRedundantUseStrict spento: i file di gui/js si caricano come <script>
  //   classici nel browser, lì 'use strict' NON è ridondante (semantica vera).
  // noAssignInExpressions spento: l'idioma di casa è
  //   (registro[chiave] ??= iniziale) + uso subito dopo (34 posti).
  // useTemplate / useExponentiationOperator / useArrowFunction spenti:
  //   stile funzionante, si legge bene, non si tocca.
  // Tutto il resto resta al livello raccomandato: gli warning di correttezza
  //   restano visibili (noUnused*) e gli errori bloccano.
  // dist/ e archive/ sono output e storico: non si lintano.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!dist", "!archive"]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useTemplate": "off",
        "useExponentiationOperator": "off"
      },
      "complexity": {
        "useArrowFunction": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noRedundantUseStrict": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noUnusedFunctionParameters": "warn"
      }
    }
  },
  "overrides": [
    {
      // Solo i TEST (3/11): un `assert` dentro un `if` SENZA `else` è il modo
      // classico in cui un test passa «in onore» — se la condizione è falsa
      // l'asserzione non gira e la run resta verde senza aver verificato nulla.
      // Il plugin GritQL (tools/biome/assert-in-if.grit) segnala quegli assert;
      // l'if/else che asserisce in ENTRAMBI i rami non lo è, perché lì
      // l'asserzione gira comunque (era il 47% dei primi 74 avvisi).
      // Severità `warn` finché i 39 punti esistenti non sono smaltiti, così
      // `npm run lint` non blocca; poi nel .grit diventa `error`.
      "includes": ["test/**"],
      "plugins": ["./tools/biome/assert-in-if.grit"]
    },
    {
      // gui/js sona PAGINE DI SCRIPT CLASSICI: le viste si chiamano fra file con
      // le globali del browser (core.js smista le tab verso drawAgenda/drawCars/
      // modal/refreshBoot...), quindi Biome da solo ciascun file e non vede i
      // usi — segnala «unused» funzioni che il routing usa davvero (triage
      // 27/10: 30 avvisi, tutti falsi positivi confermati a mano; il dead code
      // VERO — enterFlow, dayNum, row, guess, desc, locals inutili — è stato
      // rimesso a mano). Qui le regole noUnused non ha senso tenerle: in src/
      // resta tutto ON.
      "includes": ["gui/js/**"],
      "linter": { "rules": { "correctness": {
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off"
      } } }
    }
  ]
}
